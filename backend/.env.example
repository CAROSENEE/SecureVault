# Copy to .env  (or run: python generate_keys.py)
# 32 random bytes, base64 encoded. Used ONLY to wrap per-user vault keys.
VAULT_MASTER_KEY=
# Used ONLY to sign JWTs. Must be different from VAULT_MASTER_KEY.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=sqlite:///./securevault.db
CORS_ORIGINS=http://localhost:5173
